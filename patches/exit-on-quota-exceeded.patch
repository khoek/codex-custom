+fn turn_error_event(
+    thread_id: ThreadId,
+    will_retry: bool,
+    codex_error_info: CodexErrorInfo,
+) -> codex_app_server_client::AppServerEvent {
+    codex_app_server_client::AppServerEvent::ServerNotification(Box::new(

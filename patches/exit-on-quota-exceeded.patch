+        primary_session.model_provider_id = "openai".to_string();
+        primary_session.service_tier = error_from_subagent.then(|| "fast".to_string());
+        primary_session.reasoning_effort = Some(ReasoningEffortConfig::XHigh);
+        app.primary_session_configured = Some(primary_session);
+        app.exit_on_quota_exceeded = true;
+
+        for _ in 0..2 {
+            app.handle_app_server_event(
+                &app_server,
+                turn_error_event(
+                    error_thread_id,
+                    /*will_retry*/ false,
+                    CodexErrorInfo::UsageLimitExceeded,
+                ),
+            )
+            .await;
+        }
+
+        assert_eq!(count_shutdown_first_exits(&mut app_event_rx), 1);
+        assert_eq!(app.quota_exceeded_exit_thread_id, Some(primary_thread_id));
+        assert_eq!(
+            app.quota_recovery_args(),
+            vec![
+                "--model",
+                "gpt-5.6",
+                "-c",
+                "model_provider=\"openai\"",
+                "-c",
+                if error_from_subagent {
+                    "service_tier=\"fast\""
+                } else {
+                    "service_tier=\"default\""
+                },
+                "-c",
+                "model_reasoning_effort=\"xhigh\"",
+            ]
+        );
+        app_server.shutdown().await?;
+    }
+
+    Ok(())
+}

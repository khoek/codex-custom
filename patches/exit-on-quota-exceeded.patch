+#[tokio::test]
+async fn terminal_quota_error_exits_once_for_main_or_subagent() -> Result<()> {
+    for error_from_subagent in [false, true] {
+        let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+        let app_server = crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref())
+            .await
+            .expect("embedded app server");
+        let primary_thread_id =
+            ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+        let subagent_thread_id =
+            ThreadId::from_string("123e4567-e89b-12d3-a456-426614174001").unwrap();
+        let error_thread_id = if error_from_subagent {
+            subagent_thread_id
+        } else {
+            primary_thread_id
+        };
+        app.primary_thread_id = Some(primary_thread_id);
+        app.exit_on_quota_exceeded = true;
+
+        for _ in 0..2 {
+            app.handle_app_server_event(
+                &app_server,
+                turn_error_event(
+                    error_thread_id,
+                    /*will_retry*/ false,
+                    CodexErrorInfo::UsageLimitExceeded,
+                ),
+            )
+            .await;
+        }
+
+        assert_eq!(count_shutdown_first_exits(&mut app_event_rx), 1);
+        assert_eq!(app.quota_exceeded_exit_thread_id, Some(primary_thread_id));
+        app_server.shutdown().await?;
+    }
+
+    Ok(())
+}

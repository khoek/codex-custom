+fn count_shutdown_first_exits(
+    app_event_rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> usize {
+    let mut count = 0;
+    while let Ok(event) = app_event_rx.try_recv() {
+        if matches!(event, AppEvent::Exit(ExitMode::ShutdownFirst)) {
+            count += 1;
+        }
+    }
+    count
+}

+#[tokio::test]
+async fn quota_exit_ignores_disabled_retryable_and_non_quota_errors() -> Result<()> {
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    let app_server = crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref())
+        .await
+        .expect("embedded app server");
+    let primary_thread_id = ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+    app.primary_thread_id = Some(primary_thread_id);
+
+    for (enabled, will_retry, error_info) in [
+        (false, false, CodexErrorInfo::UsageLimitExceeded),
+        (true, true, CodexErrorInfo::UsageLimitExceeded),
+        (true, false, CodexErrorInfo::Other),
+    ] {
+        app.exit_on_quota_exceeded = enabled;
+        app.handle_app_server_event(
+            &app_server,
+            turn_error_event(primary_thread_id, will_retry, error_info),
+        )
+        .await;
+        assert_eq!(count_shutdown_first_exits(&mut app_event_rx), 0);
+        assert_eq!(app.quota_exceeded_exit_thread_id, None);
+    }
+
+    app_server.shutdown().await?;
+    Ok(())
+}

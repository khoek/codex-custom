+async fn start_immediately_starts_a_turn_when_idle() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+
+    chat.submit_start_immediately_prompt();
+
+    let Op::UserTurn { items, .. } = next_submit_op(&mut op_rx) else {
+        unreachable!();
+    };
+    assert_eq!(
+        items,
+        vec![UserInput::Text {
+            text: "You were interrupted, continue work".to_string(),
+            text_elements: Vec::new(),
+        }]
+    );
+    assert!(chat.input_queue.pending_steers.is_empty());
+    assert!(!chat.input_queue.submit_pending_steers_after_interrupt);
+    assert!(!chat.input_queue.submit_queued_after_interrupt);
+    assert!(op_rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn start_immediately_orders_interrupt_before_its_queued_continuation() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.on_task_started();
+
+    chat.submit_start_immediately_prompt();
+
+    next_interrupt_op(&mut op_rx);
+    assert_eq!(
+        chat.queued_user_message_texts(),
+        vec!["You were interrupted, continue work".to_string()]
+    );
+    assert!(chat.input_queue.pending_steers.is_empty());
+    assert!(chat.input_queue.submit_queued_after_interrupt);
+    handle_turn_interrupted(&mut chat, "turn-1");
+
+    let Op::UserTurn { items, .. } = next_submit_op(&mut op_rx) else {
+        unreachable!();
+    };
+    assert_eq!(
+        items,
+        vec![UserInput::Text {
+            text: "You were interrupted, continue work".to_string(),
+            text_elements: Vec::new(),
+        }]
+    );
+    assert!(chat.queued_user_message_texts().is_empty());
+    assert!(!chat.input_queue.submit_queued_after_interrupt);
+    assert!(
+        std::iter::from_fn(|| rx.try_recv().ok()).all(|event| !matches!(
+            event,
+            AppEvent::SetThreadGoalStatus {
+                status: AppThreadGoalStatus::Paused,
+                ..
+            }
+        ))
+    );
+}

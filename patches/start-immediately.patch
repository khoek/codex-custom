+#[tokio::test]
+async fn start_immediately_starts_a_turn_when_idle() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+
+    chat.submit_start_immediately_prompt();
+
+    let Op::UserTurn { items, .. } = next_submit_op(&mut op_rx) else {
+        unreachable!();
+    };
+    assert_eq!(
+        items,
+        vec![UserInput::Text {
+            text: "You were interrupted, continue work".to_string(),
+            text_elements: Vec::new(),

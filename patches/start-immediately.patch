+    pub(super) async fn resume_goal_for_start_immediately(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+    ) -> bool {
+        let response = match app_server.thread_goal_get(thread_id).await {
+            Ok(response) => response,
+            Err(err) => {
+                if self.current_displayed_thread_id() == Some(thread_id) {
+                    self.chat_widget
+                        .add_error_message(thread_goal_error_message("read", &err));
+                }
+                return false;
+            }
+        };
+        if self.current_displayed_thread_id() != Some(thread_id) {
+            return false;
+        }
+
+        match response.goal.map(|goal| goal.status) {
+            Some(
+                ThreadGoalStatus::Paused
+                | ThreadGoalStatus::Blocked
+                | ThreadGoalStatus::UsageLimited,
+            ) => {
+                self.set_thread_goal_status(app_server, thread_id, ThreadGoalStatus::Active)
+                    .await
+            }
+            Some(
+                ThreadGoalStatus::Active
+                | ThreadGoalStatus::BudgetLimited
+                | ThreadGoalStatus::Complete,
+            )
+            | None => true,
+        }
+    }

+#[tokio::test]
+async fn start_immediately_resumes_a_paused_goal() -> Result<()> {
+    let mut app = make_test_app().await;
+    let mut app_server =
+        crate::start_embedded_app_server_for_picker(app.chat_widget.config_ref()).await?;
+    let started = app_server
+        .start_thread(app.chat_widget.config_ref())
+        .await?;
+    let thread_id = started.session.thread_id;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    app_server
+        .thread_goal_set(
+            thread_id,
+            Some("Finish the interrupted work".to_string()),
+            Some(codex_app_server_protocol::ThreadGoalStatus::Paused),
+            None,
+        )
+        .await?;
+
+    assert!(
+        app.resume_goal_for_start_immediately(&mut app_server, thread_id)
+            .await
+    );
+    assert_eq!(
+        app_server
+            .thread_goal_get(thread_id)
+            .await?
+            .goal
+            .expect("goal should remain set")
+            .status,
+        codex_app_server_protocol::ThreadGoalStatus::Active
+    );
+
+    app_server.shutdown().await?;
+    Ok(())
+}

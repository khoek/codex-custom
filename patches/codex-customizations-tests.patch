+#[tokio::test]
+async fn server_overload_uses_transport_budget_then_backs_off_and_resets() -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = MockServer::start().await;
+    let overloaded = || {
+        ResponseTemplate::new(503).set_body_json(json!({
+            "error": {
+                "code": "server_is_overloaded",
+                "message": "selected model is at capacity",
+            }
+        }))
+    };
+    let plan_args = json!({
+        "plan": [{"step": "Continue after retry", "status": "completed"}],
+    })
+    .to_string();
+    let responses = mount_response_sequence(
+        &server,
+        vec![
+            overloaded(),
+            overloaded(),
+            sse_response(sse_failed(
+                "overloaded-2",
+                "server_is_overloaded",
+                "selected model is at capacity",
+            )),
+            sse_response(sse(vec![
+                ev_response_created("tool-response"),
+                ev_function_call("plan-call", "update_plan", &plan_args),
+                ev_completed("tool-response"),
+            ])),
+            overloaded(),
+            overloaded(),
+            sse_response(sse(vec![
+                ev_response_created("final-response"),
+                ev_assistant_message("final-message", "done"),
+                ev_completed("final-response"),
+            ])),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config.model_provider.request_max_retries = Some(1);
+            config.model_provider.stream_max_retries = Some(2);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    tokio::time::pause();
+
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "keep working".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+
+    let mut retry_events = Vec::new();
+    let mut request_counts_at_retry = Vec::new();
+    loop {
+        match test.codex.next_event().await?.msg {
+            EventMsg::StreamError(event) => {
+                retry_events.push((
+                    event.message,
+                    event.codex_error_info,
+                    event.additional_details,
+                ));
+                request_counts_at_retry.push(responses.requests().len());
+                tokio::time::advance(Duration::from_secs(60)).await;
+            }
+            EventMsg::Error(event) => panic!("capacity retry aborted the turn: {event:?}"),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+
+    assert_eq!(
+        retry_events,
+        vec![
+            (
+                "Reconnecting... 1/2".to_string(),
+                Some(CodexErrorInfo::ServerOverloaded),
+                None,
+            ),
+            (
+                "Reconnecting... 2/2".to_string(),
+                Some(CodexErrorInfo::ServerOverloaded),
+                None,
+            ),
+            (
+                "Reconnecting... 1/2".to_string(),
+                Some(CodexErrorInfo::ServerOverloaded),
+                None,
+            ),
+        ]
+    );
+    assert_eq!(request_counts_at_retry, vec![2, 3, 6]);
+    assert_eq!(responses.requests().len(), 7);
+
+    Ok(())
+}
+
+#[tokio::test]
+async fn server_overload_exhausts_shared_stream_retry_budget() -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    for (max_retries, first_error) in [
+        (0, "server_is_overloaded"),
+        (2, "server_is_overloaded"),
+        (2, "rate_limit_exceeded"),
+    ] {
+        let server = MockServer::start().await;
+        let responses = mount_response_sequence(
+            &server,
+            (0..=max_retries)
+                .map(|attempt| {
+                    sse_response(sse_failed(
+                        &format!("failed-{attempt}"),
+                        if attempt == 0 {
+                            first_error
+                        } else {
+                            "server_is_overloaded"
+                        },
+                        "temporary model refusal",
+                    ))
+                })
+                .collect(),
+        )
+        .await;
+        let test = test_codex()
+            .with_config(move |config| {
+                config.model_provider.request_max_retries = Some(0);
+                config.model_provider.stream_max_retries = Some(max_retries);
+            })
+            .build_with_auto_env(&server)
+            .await?;
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "keep working".into(),
+                text_elements: Vec::new(),
+            }]))
+            .await?;
+
+        let mut retries = Vec::new();
+        let mut errors = Vec::new();
+        loop {
+            match test.codex.next_event().await?.msg {
+                EventMsg::StreamError(event) => retries.push(event.message),
+                EventMsg::Error(event) => errors.push(event.codex_error_info),
+                EventMsg::TurnComplete(_) => break,
+                _ => {}
+            }
+        }
+        assert_eq!(
+            retries,
+            (1..=max_retries)
+                .map(|attempt| format!("Reconnecting... {attempt}/{max_retries}"))
+                .collect::<Vec<_>>()
+        );
+        assert_eq!(errors, vec![Some(CodexErrorInfo::ServerOverloaded)]);
+        assert_eq!(responses.requests().len() as u64, max_retries + 1);
+    }
+    Ok(())
+}

diff --git a/codex-rs/tui/src/app/tests/reserve_disabled_tests.rs b/codex-rs/tui/src/app/tests/reserve_disabled_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb4231a01ddcf50b1bf070d8e54718417b6df590
--- /dev/null
+++ b/codex-rs/tui/src/app/tests/reserve_disabled_tests.rs
@@ -0,0 +1,197 @@
+//! Exercise the custom build's Reserve opt-out through real account usage reads.
+
+use super::*;
+use app_test_support::ChatGptAuthFixture;
+use app_test_support::write_chatgpt_auth;
+use codex_app_server_protocol::CodexErrorInfo;
+use codex_app_server_protocol::ErrorNotification;
+use codex_config::types::AuthCredentialsStoreMode;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+#[tokio::test]
+async fn reserve_disabled_keeps_selected_model_and_releases_queued_input() -> Result<()> {
+    for banner_type in ["luna_reserve", "model_recovery"] {
+        let backend = MockServer::start().await;
+        let home = tempdir()?;
+        write_chatgpt_auth(
+            home.path(),
+            ChatGptAuthFixture::new("local-test-token")
+                .account_id("workspace-a")
+                .chatgpt_user_id("user-a")
+                .plan_type("plus"),
+            AuthCredentialsStoreMode::File,
+        )
+        .expect("write test account");
+        std::fs::write(
+            home.path().join("config.toml"),
+            format!(
+                "chatgpt_base_url = {:?}\ncli_auth_credentials_store = \"file\"\n",
+                backend.uri()
+            ),
+        )?;
+        let (mut app, mut events, mut ops) = make_test_app_with_channels().await;
+        app.config.codex_home = home.path().to_path_buf().abs();
+        app.config.chatgpt_base_url = backend.uri();
+        app.config.sqlite = codex_state::SqliteConfig::new_for_testing(home.path().abs());
+        app.config.model = Some("gpt-6-astra".into());
+        app.config.model_reasoning_effort = Some(ReasoningEffortConfig::XHigh);
+        let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+        let started = server.start_thread(&app.config).await?;
+        app.enqueue_primary_thread_session(started.session, started.turns)
+            .await?;
+        luna_reserve_recovery_tests::configure_reserve_catalog(&mut app);
+        app.chat_widget.set_model("gpt-6-astra");
+        app.chat_widget
+            .set_reasoning_effort(Some(ReasoningEffortConfig::XHigh));
+        let expected_mode = app.chat_widget.effective_collaboration_mode();
+        let expected_session = app.primary_session_configured.clone();
+        while events.try_recv().is_ok() {}
+        while ops.try_recv().is_ok() {}
+
+        Mock::given(method("GET"))
+            .and(path("/api/codex/usage"))
+            .respond_with(ResponseTemplate::new(/*s*/ 200).set_body_json(json!({
+                "account_id": "workspace-a", "user_id": "user-a", "plan_type": "plus",
+                "rate_limit": {"allowed": false, "limit_reached": true,
+                    "primary_window": {"used_percent": 100, "limit_window_seconds": 18000,
+                        "reset_after_seconds": 1800, "reset_at": 2000000000}},
+                "rate_limit_upsell": {
+                    "banner_type": banner_type, "presentation": "dismissible",
+                    "blocked_model_slug": "gpt-6-astra",
+                    "fallback_model_slugs": ["gpt-reserve", "unavailable-model"],
+                    "title": "Switch to Reserve", "description": "Reserve offer",
+                    "ctas": []
+                }
+            })))
+            .expect(/*r*/ 1)
+            .mount(&backend)
+            .await;
+
+        // Queue before the usage response arrives: filtering must happen before the
+        // response can hold recovery or rewrite an already-composed UserTurn.
+        app.chat_widget
+            .restore_user_message_to_composer(crate::chatwidget::UserMessage::from("continue"));
+        app.chat_widget
+            .handle_key_event(KeyEvent::from(KeyCode::Enter));
+        let pending = std::iter::from_fn(|| events.try_recv().ok())
+            .find_map(|event| match event {
+                AppEvent::CodexOp(op @ AppCommand::UserTurn { .. }) => Some(op),
+                _ => None,
+            })
+            .expect("queued user turn");
+        app.refresh_rate_limits(&server, RateLimitRefreshOrigin::Periodic);
+        let loaded = tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
+            loop {
+                let event = events.recv().await.expect("app event channel");
+                if matches!(event, AppEvent::RateLimitsLoaded { .. }) {
+                    break event;
+                }
+            }
+        })
+        .await?;
+        let AppEvent::RateLimitsLoaded {
+            result: Ok(response),
+            ..
+        } = &loaded
+        else {
+            panic!("usage read failed: {loaded:?}");
+        };
+        assert_eq!(response.ordinary_usage_allowed, Some(false));
+        assert_eq!(
+            response.rate_limits.primary.as_ref().unwrap().used_percent,
+            100
+        );
+        if banner_type == "luna_reserve" {
+            assert_eq!(response.rate_limit_upsell, None);
+        } else {
+            assert_eq!(
+                response.rate_limit_upsell.as_ref().unwrap()["fallback_model_slugs"],
+                json!(["unavailable-model"])
+            );
+        }
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        app.handle_event(&mut tui, &mut server, loaded).await?;
+        assert_eq!(
+            app.chat_widget.effective_collaboration_mode(),
+            expected_mode
+        );
+        assert_eq!(app.primary_session_configured, expected_session);
+        assert!(!app.chat_widget.defer_pending_turn_for_luna_reserve());
+        let mut actual = pending.clone();
+        app.chat_widget
+            .apply_reserve_fallback_to_pending_turn(&mut actual);
+        assert_eq!(actual, pending);
+        assert!(!home.path().join("tui-luna-reserve").exists());
+        if banner_type == "luna_reserve" {
+            insta::assert_snapshot!(
+                "reserve_disabled_composer",
+                render_bottom_popup(&app.chat_widget, /*width*/ 90)
+            );
+        }
+        let requests = backend.received_requests().await.unwrap();
+        assert!(
+            !requests[0]
+                .headers
+                .contains_key("x-openai-codex-luna-reserve")
+        );
+        // Terminal quota errors still use the supervisor and preserve task settings,
+        // including when a child reports exhaustion after an unsolicited Reserve offer.
+        app.exit_on_quota_exceeded = true;
+        let primary = app.primary_thread_id.unwrap();
+        let error_thread = if banner_type == "luna_reserve" {
+            primary
+        } else {
+            let child = ThreadId::new();
+            app.thread_event_channels.insert(
+                child,
+                ThreadEventChannel::new(THREAD_EVENT_CHANNEL_CAPACITY),
+            );
+            child
+        };
+        app.handle_app_server_event(
+            &server,
+            codex_app_server_client::AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::Error(ErrorNotification {
+                    error: AppServerTurnError {
+                        misalignment: None,
+                        message: "Usage limit reached.".into(),
+                        codex_error_info: Some(CodexErrorInfo::UsageLimitExceeded),
+                        additional_details: None,
+                    },
+                    will_retry: false,
+                    thread_id: error_thread.to_string(),
+                    turn_id: "turn-1".into(),
+                }),
+            )),
+        )
+        .await;
+        assert_eq!(app.quota_exceeded_exit_thread_id, Some(primary));
+        let handoff: serde_json::Value = serde_json::from_slice(&std::fs::read(
+            app.quota_handoff_path
+                .as_ref()
+                .expect("saved restart input"),
+        )?)?;
+        assert_eq!(
+            handoff["resume_args"],
+            json!([
+                "--model",
+                "gpt-6-astra",
+                "-c",
+                "model_provider=\"openai\"",
+                "-c",
+                "service_tier=\"default\"",
+                "-c",
+                "model_reasoning_effort=\"xhigh\""
+            ])
+        );
+        backend.verify().await;
+        server.shutdown().await?;
+    }
+    Ok(())
+}

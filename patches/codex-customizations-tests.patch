+            Some(Duration::from_secs(seconds))
+        );
+    }
+    let advice = RetryAfter::from_delay(Duration::from_secs(120)).unwrap();
+    let error = CodexErr::QuotaExceeded.with_retry_after(advice);
+    let delay = error.retry_delay(1).unwrap();
+    assert!((Duration::from_secs(119)..=Duration::from_secs(120)).contains(&delay));
+}

+            .with_config(move |config| {
+                config.model_provider.request_max_retries = Some(0);
+                config.model_provider.stream_max_retries = Some(2);
+            }),
+    )
+    .await?;
+    let codex = harness.test().codex.clone();
+    mount_sse_once(
+        harness.server(),
+        sse(vec![
+            responses::ev_assistant_message("m1", "REMOTE_REPLY"),
+            responses::ev_completed("resp-1"),
+        ]),
+    )
+    .await;
+    codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "prepare compaction".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_turn_complete(&codex).await;
+
+    let overloaded = ResponseTemplate::new(503).set_body_json(json!({
+        "error": {
+            "code": "server_is_overloaded",
+            "message": "selected model is at capacity",
+        }
+    }));
+    let failures = vec![overloaded.clone(), overloaded.clone(), overloaded];
+    let compact_mock = responses::mount_response_sequence(harness.server(), failures).await;
+    codex.submit(Op::Compact).await?;
+
+    let mut retries = Vec::new();
+    let mut errors = Vec::new();
+    loop {
+        match codex.next_event().await?.msg {
+            EventMsg::StreamError(event) => {
+                retries.push((event.message, event.codex_error_info));
+            }
+            EventMsg::Error(event) => errors.push(event.codex_error_info),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        retries,
+        vec![
+            (
+                "Reconnecting... 1/2".to_string(),
+                Some(CodexErrorInfo::ServerOverloaded)
+            ),
+            (
+                "Reconnecting... 2/2".to_string(),
+                Some(CodexErrorInfo::ServerOverloaded)
+            ),
+        ]
+    );
+    assert_eq!(errors, vec![Some(CodexErrorInfo::ServerOverloaded)]);

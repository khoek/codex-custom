diff --git a/codex-rs/core/src/session/mod.rs b/codex-rs/core/src/session/mod.rs
index d96ad4eca170c3aaaec2af0e0adf29e0a2d7f377..17a104677aac40fad85f83ad5a632db44088f2e3 100644
--- a/codex-rs/core/src/session/mod.rs
+++ b/codex-rs/core/src/session/mod.rs
@@ -4717,14 +4717,19 @@ impl Session {
         message: impl Into<String>,
         codex_error: CodexErr,
     ) {
-        let additional_details = codex_error.to_string();
-        let codex_error_info = CodexErrorInfo::ResponseStreamDisconnected {
-            http_status_code: codex_error.http_status_code_value(),
+        let (codex_error_info, additional_details) = match codex_error.details() {
+            CodexErrorDetails::ServerOverloaded => (codex_error.to_codex_protocol_error(), None),
+            _ => (
+                CodexErrorInfo::ResponseStreamDisconnected {
+                    http_status_code: codex_error.http_status_code_value(),
+                },
+                Some(codex_error.to_string()),
+            ),
         };
         let event = EventMsg::StreamError(StreamErrorEvent {
             message: message.into(),
             codex_error_info: Some(codex_error_info),
-            additional_details: Some(additional_details),
+            additional_details,
         });
         self.send_event(turn_context, event).await;
     }

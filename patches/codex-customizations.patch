+/// Callers own cancellation of this wait along with the inference request.
+pub(crate) async fn wait_for_quota_retry(
+    retries: &mut u64,
+    err: CodexErr,
+    sess: &Session,
+    turn_context: &TurnContext,
+    operation: RetryOperation,
+) -> Result<(), CodexErr> {
+    *retries = retries.saturating_add(1);
+    let Some(delay) = err.retry_delay(*retries) else {
+        return Err(err);
+    };
+    let retry_at = err
+        .retry_after()
+        .map(RetryAfter::deadline)
+        .unwrap_or_else(|| Instant::now() + delay);
+    warn!(turn_id = %turn_context.sub_id, retries = *retries, ?delay, "API quota unavailable; waiting to retry");
+    sess.notify_stream_error(
+        turn_context,
+        format!(
+            "API quota unavailable; retrying in {}s (attempt {retries})",
+            delay.as_secs()
+        ),
+        err,
+    )
+    .await;
+    codex_client::record_retry!(*retries, delay, operation);
+    tokio::time::sleep_until(retry_at).await;
+    Ok(())
+}

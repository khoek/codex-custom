+pub(crate) async fn handle_server_overload_retry(
+    retries: &mut u64,
+    err: CodexErr,
+    sess: &Session,
+    turn_context: &TurnContext,
+) {
+    *retries = retries.saturating_add(1);
+    let retry_count = *retries;
+    let exponent = retry_count.saturating_sub(1).min(5) as u32;
+    let delay = (SERVER_OVERLOAD_INITIAL_RETRY_DELAY * 2_u32.saturating_pow(exponent))
+        .min(SERVER_OVERLOAD_MAX_RETRY_DELAY);
+    warn!(
+        turn_id = %turn_context.sub_id,
+        retry_count,
+        ?delay,
+        "model at capacity; retrying request"
+    );
+    sess.notify_stream_error(
+        turn_context,
+        format!(
+            "Model at capacity; retrying in {}s (attempt {retry_count})",
+            delay.as_secs()
+        ),
+        err,
+    )
+    .await;
+    tokio::time::sleep(delay).await;
+}

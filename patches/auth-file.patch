+#[test]
+fn resolves_process_local_auth_file_override() {
+    let codex_home = tempdir().unwrap();
+    let auth_root = tempdir().unwrap();
+    let auth_file = auth_root.path().join("private-auth.json");
+    assert_eq!(
+        resolve_auth_file(codex_home.path(), Some(&auth_file)),
+        auth_file
+    );
+    assert_eq!(
+        resolve_auth_file(codex_home.path(), Some(Path::new("relative.json"))),
+        codex_home.path().join("relative.json")
+    );
+    assert_eq!(
+        resolve_auth_file(codex_home.path(), None),
+        codex_home.path().join("auth.json")
+    );
+}

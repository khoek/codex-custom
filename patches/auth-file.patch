index 0000000000000000000000000000000000000000..e1ccfe230655fe522153b6de6936dbb5139d6211
--- /dev/null
+++ b/codex-rs/login/src/auth/credential_lock.rs
@@ -0,0 +1,370 @@
+//! Consumer-side participation in the broker-managed credential lock protocol.
+//!
+//! A configured process retains the transferred use lock for its entire lifetime. Every
+//! mutation takes the independent mutation lock exclusively. The broker can
+//! therefore take both locks exclusively before replacing or reclaiming a slot,
+//! while multiple consumers can safely share a slot between broker operations.
+
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io;
+#[cfg(unix)]
+use std::io::Read;
+#[cfg(unix)]
+use std::io::Write;
+#[cfg(unix)]
+use std::os::fd::AsRawFd;
+#[cfg(unix)]
+use std::os::fd::FromRawFd;
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+#[cfg(unix)]
+use std::os::unix::net::UnixStream;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use tokio::time::sleep;
+
+const STARTUP_NONCE_HEX_LEN: usize = 64;
+const RETRY_DELAY: Duration = Duration::from_millis(50);
+
+struct ProcessCredentialLocks {
+    mutation_path: PathBuf,
+    _use_guard: Guard,
+    invalid: AtomicBool,
+}
+
+static PROCESS_CREDENTIAL_LOCKS: OnceLock<ProcessCredentialLocks> = OnceLock::new();
+
+#[derive(Debug)]
+pub(super) struct Guard {
+    _file: File,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CredentialUseLockMode {
+    Shared,
+    Exclusive,
+}
+
+impl std::str::FromStr for CredentialUseLockMode {
+    type Err = String;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "shared" => Ok(Self::Shared),
+            "exclusive" => Ok(Self::Exclusive),
+            _ => Err("expected shared or exclusive".to_string()),
+        }
+    }
+}
+
+use CredentialUseLockMode as LockMode;
+
+pub(super) fn configure(
+    use_path: PathBuf,
+    use_mode: CredentialUseLockMode,
+    mutation_path: PathBuf,
+    startup_socket: PathBuf,
+    startup_nonce: String,
+) -> io::Result<()> {
+    validate_lock_path(&use_path, "credential use")?;
+    validate_lock_path(&mutation_path, "credential mutation")?;
+    validate_lock_path(&startup_socket, "credential startup socket")?;
+    validate_startup_nonce(&startup_nonce)?;
+    if use_path == mutation_path {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "credential use and mutation locks must be different files",
+        ));
+    }
+
+    // Validate both broker-owned files before taking the lifetime use lock so a
+    // malformed slot fails at startup rather than at its first token refresh.
+    let mutation_file = open_lock_file(&mutation_path)?;
+    let use_file = open_lock_file(&use_path)?;
+    ensure_distinct_files(&use_file, &mutation_file)?;
+    let use_guard = join_startup_barrier(&use_path, use_mode, &startup_socket, &startup_nonce)?;
+    PROCESS_CREDENTIAL_LOCKS
+        .set(ProcessCredentialLocks {
+            mutation_path,
+            _use_guard: use_guard,
+            invalid: AtomicBool::new(false),
+        })
+        .map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "credential locks are already configured",
+            )
+        })
+}
+
+fn join_startup_barrier(
+    use_path: &Path,
+    use_mode: CredentialUseLockMode,
+    startup_socket: &Path,
+    startup_nonce: &str,
+) -> io::Result<Guard> {
+    let mut startup = connect_startup_socket(startup_socket)?;
+    let use_file = complete_startup_barrier(&mut startup, startup_nonce)?;
+    validate_broker_managed_file(use_path, &use_file.metadata()?)?;
+    // SCM_RIGHTS preserves the already locked open-file description, including
+    // an exclusive lock, without an unlock/relock gap during process startup.
+    match use_mode {
+        LockMode::Shared => use_file.try_lock_shared(),
+        LockMode::Exclusive => use_file.try_lock(),
+    }
+    .map_err(io::Error::other)?;
+    Ok(Guard { _file: use_file })
+}
+
+#[cfg(unix)]
+fn connect_startup_socket(path: &Path) -> io::Result<UnixStream> {
+    UnixStream::connect(path)
+}
+
+#[cfg(not(unix))]
+fn connect_startup_socket(_path: &Path) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "managed credential startup barriers require Unix sockets",
+    ))
+}
+
+#[cfg(unix)]
+fn complete_startup_barrier(stream: &mut UnixStream, nonce: &str) -> io::Result<File> {
+    let ready = format!("READY {nonce}\n");
+    stream.write_all(ready.as_bytes())?;
+    stream.flush()?;
+
+    let expected = format!("GO {nonce}\n");
+    let mut response = vec![0_u8; expected.len()];
+    let mut iov = libc::iovec {
+        iov_base: response.as_mut_ptr().cast(),
+        iov_len: response.len(),
+    };
+    // A cmsghdr array provides the alignment required by the ancillary-message API.
+    let mut control = [unsafe { std::mem::zeroed::<libc::cmsghdr>() }; 2];
+    let mut message = unsafe { std::mem::zeroed::<libc::msghdr>() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = std::mem::size_of_val(&control) as _;
+    let read = unsafe { libc::recvmsg(stream.as_raw_fd(), &mut message, 0) };
+    if read < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut descriptors = Vec::new();
+    unsafe {
+        let mut header = libc::CMSG_FIRSTHDR(&message);
+        while !header.is_null() {
+            if (*header).cmsg_level == libc::SOL_SOCKET && (*header).cmsg_type == libc::SCM_RIGHTS {
+                let count = ((*header).cmsg_len as usize - libc::CMSG_LEN(0) as usize)
+                    / std::mem::size_of::<libc::c_int>();
+                let data = libc::CMSG_DATA(header).cast::<libc::c_int>();
+                for index in 0..count {
+                    descriptors.push(File::from_raw_fd(*data.add(index)));
+                }
+            }
+            header = libc::CMSG_NXTHDR(&message, header);
+        }
+    }
+    if read == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::UnexpectedEof,
+            "credential startup barrier closed before GO",
+        ));
+    }
+    if message.msg_flags & libc::MSG_CTRUNC != 0 || descriptors.len() != 1 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "credential startup requires one use-lock descriptor",
+        ));
+    }
+    let file = descriptors.pop().ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            "missing credential use-lock descriptor",
+        )
+    })?;
+    if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    stream.read_exact(&mut response[read as usize..])?;
+    if response != expected.as_bytes() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "credential startup barrier returned an invalid response",
+        ));
+    }
+    Ok(file)
+}

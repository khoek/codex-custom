+#[cfg(not(unix))]
+fn complete_startup_barrier(_stream: &mut (), _nonce: &str) -> io::Result<File> {
+    unreachable!("connect_startup_socket always fails on non-Unix platforms")
+}
+
+pub(super) fn acquire_configured_mutation() -> io::Result<Option<Guard>> {
+    PROCESS_CREDENTIAL_LOCKS
+        .get()
+        .map(|locks| acquire_blocking(&locks.mutation_path, LockMode::Exclusive))
+        .transpose()
+}
+
+pub(super) fn is_configured() -> bool {
+    PROCESS_CREDENTIAL_LOCKS.get().is_some()
+}
+
+pub fn managed_credential_is_invalid() -> bool {
+    PROCESS_CREDENTIAL_LOCKS
+        .get()
+        .is_some_and(|locks| locks.invalid.load(Ordering::Relaxed))
+}
+
+pub(super) fn mark_invalid() {
+    if let Some(locks) = PROCESS_CREDENTIAL_LOCKS.get() {
+        locks.invalid.store(true, Ordering::Relaxed);
+    }
+}
+
+pub(super) async fn acquire_for_refresh() -> io::Result<Guard> {
+    let locks = PROCESS_CREDENTIAL_LOCKS.get().ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            "credential mutation lock is not configured",
+        )
+    })?;
+    let path = &locks.mutation_path;
+    let file = open_lock_file(path)?;
+
+    loop {
+        match file.try_lock() {
+            Ok(()) => {
+                validate_broker_managed_file(path, &file.metadata()?)?;
+                return Ok(Guard { _file: file });
+            }
+            Err(std::fs::TryLockError::WouldBlock) => sleep(RETRY_DELAY).await,
+            Err(std::fs::TryLockError::Error(error)) => return Err(error),
+        }
+    }
+}
+
+fn acquire_blocking(path: &Path, mode: LockMode) -> io::Result<Guard> {
+    let file = open_lock_file(path)?;
+    match mode {
+        LockMode::Shared => file.lock_shared()?,
+        LockMode::Exclusive => file.lock()?,
+    }
+    validate_broker_managed_file(path, &file.metadata()?)?;
+    Ok(Guard { _file: file })
+}
+
+fn open_lock_file(path: &Path) -> io::Result<File> {
+    let mut options = OpenOptions::new();
+    options.read(true).write(true).truncate(false);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW);
+    let file = options.open(path)?;
+    let opened = file.metadata()?;
+    if !opened.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("credential lock {} is not a regular file", path.display()),
+        ));
+    }
+    validate_broker_managed_file(path, &opened)?;
+    Ok(file)
+}
+
+fn ensure_distinct_files(first: &File, second: &File) -> io::Result<()> {
+    #[cfg(unix)]
+    if first.metadata()?.dev() == second.metadata()?.dev()
+        && first.metadata()?.ino() == second.metadata()?.ino()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "credential use and mutation locks must be different files",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_broker_managed_file(path: &Path, opened: &std::fs::Metadata) -> io::Result<()> {
+    let named = std::fs::symlink_metadata(path)?;
+    if named.file_type().is_symlink() || !named.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("credential lock {} is not a regular file", path.display()),
+        ));
+    }
+    #[cfg(unix)]
+    {
+        if opened.dev() != named.dev() || opened.ino() != named.ino() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("credential lock {} changed while opening", path.display()),
+            ));
+        }
+        if opened.mode() & 0o777 != 0o600 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("credential lock {} must have mode 0600", path.display()),
+            ));
+        }
+        if opened.nlink() != 1 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!(
+                    "credential lock {} must have exactly one hard link",
+                    path.display()
+                ),
+            ));
+        }
+        // SAFETY: geteuid takes no pointers and has no preconditions.
+        if opened.uid() != unsafe { libc::geteuid() } {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!(
+                    "credential lock {} is owned by another user",
+                    path.display()
+                ),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn validate_lock_path(path: &Path, name: &str) -> io::Result<()> {
+    if path.as_os_str().is_empty() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("{name} lock path cannot be empty"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_startup_nonce(nonce: &str) -> io::Result<()> {
+    if nonce.len() != STARTUP_NONCE_HEX_LEN
+        || !nonce
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "credential startup nonce must be exactly 64 lowercase hexadecimal characters",
+        ));
+    }
+    Ok(())
+}

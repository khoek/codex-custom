 pub(super) fn get_auth_file(codex_home: &Path) -> PathBuf {
-    codex_home.join("auth.json")
+    let configured = env::var_os(super::CODEX_AUTH_FILE_ENV_VAR);
+    resolve_auth_file(codex_home, configured.as_deref())
+}
+
+fn resolve_auth_file(codex_home: &Path, configured: Option<&OsStr>) -> PathBuf {
+    configured
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .map(|path| {
+            if path.is_absolute() {
+                path
+            } else {
+                codex_home.join(path)
+            }
+        })
+        .unwrap_or_else(|| codex_home.join("auth.json"))
 }
 

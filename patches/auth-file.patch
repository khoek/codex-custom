+fn spawn_holder(directory: &Path, lock_path: &Path, name: &str, mode: &str) -> Child {
+    Command::new(env::current_exe().unwrap())
+        .arg("--exact")
+        .arg(HELPER_TEST_NAME)
+        .arg("--nocapture")
+        .env(HELPER_MODE, mode)
+        .env(HELPER_LOCK_PATH, lock_path)
+        .env(HELPER_READY_PATH, directory.join(format!("{name}.ready")))
+        .env(
+            HELPER_RELEASE_PATH,
+            directory.join(format!("{name}.release")),
+        )
+        .spawn()
+        .unwrap()
+}
+
+fn wait_for_path(path: &Path) {
+    let started = Instant::now();
+    while !path.exists() {
+        assert!(
+            started.elapsed() < Duration::from_secs(10),
+            "timed out waiting for {}",
+            path.display()
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn assert_path_stays_absent(path: &Path) {
+    std::thread::sleep(Duration::from_millis(200));
+    assert!(!path.exists(), "{} unexpectedly exists", path.display());
+}
+
+fn wait_for_success(child: &mut Child) {
+    let status = child.wait().unwrap();
+    assert!(status.success(), "lock helper failed with {status}");
+}

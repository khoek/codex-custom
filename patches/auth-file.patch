 pub(super) fn get_auth_file(codex_home: &Path) -> PathBuf {
-    codex_home.join("auth.json")
+    resolve_auth_file(codex_home, AUTH_FILE_OVERRIDE.get().map(PathBuf::as_path))
+}
+
+fn resolve_auth_file(codex_home: &Path, configured: Option<&Path>) -> PathBuf {
+    match configured.filter(|path| !path.as_os_str().is_empty()) {
+        Some(path) if path.is_absolute() => path.to_path_buf(),
+        Some(path) => codex_home.join(path),
+        None => codex_home.join("auth.json"),
+    }
 }
 

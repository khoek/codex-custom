+static AUTH_FILE_OVERRIDE: OnceLock<PathBuf> = OnceLock::new();
+
+pub(super) fn set_auth_file_override(path: PathBuf) -> std::io::Result<()> {
+    AUTH_FILE_OVERRIDE.set(path).map_err(|_| {
+        std::io::Error::new(
+            std::io::ErrorKind::AlreadyExists,
+            "auth file override is already set",
+        )
+    })
+}

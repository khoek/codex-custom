+#[test]
+fn resolves_auth_file_override_without_mutating_process_environment() {
+    let codex_home = tempdir().unwrap();
+    let auth_root = tempdir().unwrap();
+    let auth_file = auth_root.path().join("private-auth.json");
+    assert_eq!(
+        resolve_auth_file(codex_home.path(), Some(auth_file.as_os_str())),
+        auth_file
+    );
+    assert_eq!(
+        resolve_auth_file(
+            codex_home.path(),
+            Some(std::ffi::OsStr::new("relative.json")),
+        ),
+        codex_home.path().join("relative.json")
+    );
+    assert_eq!(
+        resolve_auth_file(codex_home.path(), None),
+        codex_home.path().join("auth.json")
+    );
+}

+#[serial_test::serial(auth_env)]
+#[tokio::test]
+async fn concurrent_managers_share_one_canonical_refresh_transaction() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/oauth/token"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "access_token": "canonical-access-token",
+            "refresh_token": "canonical-refresh-token"
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let endpoint = format!("{}/oauth/token", server.uri());
+    let _endpoint_guard = EnvGuard::set(REFRESH_TOKEN_URL_OVERRIDE_ENV_VAR, endpoint);
+    let canonical = TempDir::new()?;
+    let canonical_auth = canonical.path().join("account.json");
+    let first_home = TempDir::new()?;
+    let second_home = TempDir::new()?;
+    let stale_home = TempDir::new()?;
+    for home in [&first_home, &second_home, &stale_home] {
+        let active_auth = home.path().join("auth.json");
+        #[cfg(unix)]
+        std::os::unix::fs::symlink(&canonical_auth, active_auth)?;
+        #[cfg(windows)]
+        std::os::windows::fs::symlink_file(&canonical_auth, active_auth)?;
+    }
+    let first = AuthManager::shared(
+        first_home.path().to_path_buf(),
+        false,
+        AuthCredentialsStoreMode::File,
+        None,
+        None,
+        AuthKeyringBackendKind::default(),
+        codex_login::test_support::transport_default_auth_route_config(),
+    )
+    .await;
+    let second = AuthManager::shared(
+        second_home.path().to_path_buf(),
+        false,
+        AuthCredentialsStoreMode::File,
+        None,
+        None,
+        AuthKeyringBackendKind::default(),
+        codex_login::test_support::transport_default_auth_route_config(),
+    )
+    .await;
+    let stale = AuthManager::shared(
+        stale_home.path().to_path_buf(),
+        false,
+        AuthCredentialsStoreMode::File,
+        None,
+        None,
+        AuthKeyringBackendKind::default(),
+        codex_login::test_support::transport_default_auth_route_config(),
+    )
+    .await;
+    let initial_auth = AuthDotJson {
+        auth_mode: Some(AuthMode::Chatgpt),
+        openai_api_key: None,
+        tokens: Some(build_tokens(INITIAL_ACCESS_TOKEN, INITIAL_REFRESH_TOKEN)),
+        last_refresh: Some(Utc::now() - Duration::days(1)),
+        agent_identity: None,
+        personal_access_token: None,
+        bedrock_api_key: None,
+    };
+    save_auth(
+        first_home.path(),
+        &initial_auth,
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    )?;
+    first.reload().await;
+    second.reload().await;
+    stale.reload().await;
+
+    let (first_result, second_result) = tokio::join!(first.refresh_token(), second.refresh_token());
+    first_result?;
+    second_result?;
+    stale.refresh_token_from_authority().await?;
+
+    let stored = load_auth_dot_json(
+        first_home.path(),
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    )?
+    .context("canonical auth should exist")?;
+    assert_eq!(
+        stored
+            .tokens
+            .as_ref()
+            .context("canonical tokens should exist")?
+            .refresh_token,
+        "canonical-refresh-token"
+    );
+    server.verify().await;
+    Ok(())
+}

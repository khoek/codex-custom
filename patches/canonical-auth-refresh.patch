@@ -0,0 +1,89 @@
+//! Cross-process serialization for file-backed ChatGPT credential refreshes.
+//!
+//! The guard is acquired before the authoritative disk reload and held until the
+//! provider response has been persisted. The lock is keyed by the resolved canonical
+//! auth file, so an active auth.json link and an explicit `--auth-file` path rendezvous
+//! with the same account.
+
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::fs::{self};
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+
+use tokio::time::sleep;
+
+const RETRY_DELAY: Duration = Duration::from_millis(50);
+
+pub(super) struct Guard {
+    _file: File,
+}
+
+pub(super) async fn acquire(codex_home: &Path) -> std::io::Result<Guard> {
+    let auth_file = super::storage::get_auth_file(codex_home);
+    let path = lock_path(&auth_file);
+    let parent = path.parent().ok_or_else(|| {
+        std::io::Error::other("credential refresh lock path has no parent directory")
+    })?;
+    fs::create_dir_all(parent)?;
+    let mut options = OpenOptions::new();
+    options.read(true).write(true).create(true).truncate(false);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let file = options.open(&path)?;
+
+    loop {
+        match file.try_lock() {
+            Ok(()) => return Ok(Guard { _file: file }),
+            Err(std::fs::TryLockError::WouldBlock) => sleep(RETRY_DELAY).await,
+            Err(std::fs::TryLockError::Error(error)) => return Err(error),
+        }
+    }
+}
+
+pub(super) fn lock_path(auth_file: &Path) -> PathBuf {
+    let canonical = canonical_auth_path(auth_file);
+    let name = canonical
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("auth.json");
+    canonical.with_file_name(format!("{name}.refresh.lock"))
+}
+
+fn canonical_auth_path(path: &Path) -> PathBuf {
+    if let Ok(canonical) = path.canonicalize() {
+        return canonical;
+    }
+    let Some(parent) = path.parent() else {
+        return path.to_owned();
+    };
+    parent
+        .canonicalize()
+        .map(|parent| parent.join(path.file_name().unwrap_or_default()))
+        .unwrap_or_else(|_| path.to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+
+    use tempfile::tempdir;
+
+    use super::*;
+
+    #[tokio::test]
+    async fn lock_path_follows_an_active_auth_link() {
+        let directory = tempdir().unwrap();
+        let profile = directory.path().join("profile.json");
+        fs::write(&profile, b"{}").unwrap();
+        let active = directory.path().join("auth.json");
+        #[cfg(unix)]
+        std::os::unix::fs::symlink(&profile, &active).unwrap();
+        #[cfg(windows)]
+        std::os::windows::fs::symlink_file(&profile, &active).unwrap();
+        assert_eq!(lock_path(&active), lock_path(&profile));
+    }
+}

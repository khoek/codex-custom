+fn refresh_token_failure_class(
+    reason: RefreshTokenFailedReason,
+    status: StatusCode,
+    is_invalid_grant_bad_request: bool,
+) -> &'static str {
+    match reason {
+        RefreshTokenFailedReason::Expired => "expired",
+        RefreshTokenFailedReason::Exhausted => "exhausted",
+        RefreshTokenFailedReason::Revoked => "revoked",
+        RefreshTokenFailedReason::Other if is_invalid_grant_bad_request => "invalid_grant",
+        RefreshTokenFailedReason::Other if status == StatusCode::UNAUTHORIZED => "unauthorized",
+        RefreshTokenFailedReason::Other => "transient_http",
+    }
+}

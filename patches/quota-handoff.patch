index 0000000000000000000000000000000000000000..9ff21dee6136ebcee2a2a05ee0c9d32394d1f045
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/quota_handoff.rs
@@ -0,0 +1,330 @@
+//! Durable +k handoff for local input that is not part of the rollout transcript.
+
+use std::ffi::OsStr;
+use std::fs;
+#[cfg(unix)]
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Write;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+
+use codex_protocol::ThreadId;
+use color_eyre::eyre::Result;
+use color_eyre::eyre::WrapErr;
+use color_eyre::eyre::bail;
+use serde::Deserialize;
+use serde::Serialize;
+use uuid::Uuid;
+
+use crate::bottom_pane::QueuedInputAction;
+
+use super::ChatWidget;
+use super::QueuedUserMessage;
+use super::ThreadComposerState;
+use super::UserMessageHistoryRecord;
+
+const HANDOFF_FORMAT: &str = "codex+k-input-handoff";
+const HANDOFF_VERSION: u8 = 1;
+const MAX_HANDOFF_BYTES: u64 = 16 * 1024 * 1024;
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+struct QuotaHandoff {
+    format: String,
+    version: u8,
+    handoff_id: String,
+    created_at_unix_ms: u64,
+    thread_id: String,
+    rollout_path: Option<PathBuf>,
+    resume_args: Vec<String>,
+    messages: Vec<QuotaHandoffMessage>,
+    draft: Option<ThreadComposerState>,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+struct QuotaHandoffMessage {
+    source: QuotaHandoffMessageSource,
+    queued_message: QueuedUserMessage,
+    history_record: UserMessageHistoryRecord,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum QuotaHandoffMessageSource {
+    RejectedSteer,
+    PendingSteer,
+    QueuedInput,
+}
+
+impl QuotaHandoff {
+    fn validate(&self, expected_thread_id: ThreadId) -> Result<()> {
+        if self.format != HANDOFF_FORMAT {
+            bail!("unsupported input handoff format `{}`", self.format);
+        }
+        if self.version != HANDOFF_VERSION {
+            bail!(
+                "unsupported input handoff version {}; expected {HANDOFF_VERSION}",
+                self.version
+            );
+        }
+        if self.thread_id != expected_thread_id.to_string() {
+            bail!(
+                "input handoff belongs to thread {}, not {expected_thread_id}",
+                self.thread_id
+            );
+        }
+        if self.resume_args.is_empty() {
+            bail!("input handoff contains no resume arguments");
+        }
+        Ok(())
+    }
+}
+
+impl ChatWidget {
+    /// Persist every locally pending input as an independent handoff record, along with resume
+    /// metadata even when there is no local input.
+    ///
+    /// The active turn itself is already in the rollout. Only steers, explicitly queued inputs,
+    /// and the unsent composer draft live exclusively in the TUI and need this companion file.
+    pub(crate) fn persist_quota_handoff(
+        &self,
+        thread_id: ThreadId,
+        resume_args: Vec<String>,
+        codex_home: &Path,
+    ) -> Result<PathBuf> {
+        let handoff = self.capture_quota_handoff(thread_id, resume_args);
+        let path = handoff_path(
+            self.current_rollout_path.as_deref(),
+            codex_home,
+            thread_id,
+            &handoff.handoff_id,
+        )?;
+        write_handoff(&path, &handoff)?;
+        Ok(path)
+    }
+
+    pub(crate) fn restore_quota_handoff_file(
+        &mut self,
+        path: &Path,
+        expected_thread_id: ThreadId,
+    ) -> Result<usize> {
+        let handoff = read_handoff(path)?;
+        handoff.validate(expected_thread_id)?;
+
+        let restored_messages = handoff.messages.len();
+        for message in handoff.messages {
+            self.input_queue
+                .queued_user_messages
+                .push_back(message.queued_message);
+            self.input_queue
+                .queued_user_message_history_records
+                .push_back(message.history_record);
+        }
+        if let Some(draft) = handoff.draft {
+            self.restore_composer_state(draft);
+        }
+        self.refresh_pending_input_preview();
+        self.request_redraw();
+        Ok(restored_messages)
+    }
+
+    fn capture_quota_handoff(&self, thread_id: ThreadId, resume_args: Vec<String>) -> QuotaHandoff {
+        let mut messages = Vec::new();
+
+        for (index, user_message) in self.input_queue.rejected_steers_queue.iter().enumerate() {
+            messages.push(QuotaHandoffMessage {
+                source: QuotaHandoffMessageSource::RejectedSteer,
+                queued_message: QueuedUserMessage::new(
+                    user_message.clone(),
+                    QueuedInputAction::Plain,
+                ),
+                history_record: self
+                    .input_queue
+                    .rejected_steer_history_records
+                    .get(index)
+                    .cloned()
+                    .unwrap_or(UserMessageHistoryRecord::UserMessageText),
+            });
+        }
+        for pending in &self.input_queue.pending_steers {
+            messages.push(QuotaHandoffMessage {
+                source: QuotaHandoffMessageSource::PendingSteer,
+                queued_message: QueuedUserMessage::new(
+                    pending.user_message.clone(),
+                    QueuedInputAction::Plain,
+                ),
+                history_record: pending.history_record.clone(),
+            });
+        }
+        for (index, queued_message) in self.input_queue.queued_user_messages.iter().enumerate() {
+            messages.push(QuotaHandoffMessage {
+                source: QuotaHandoffMessageSource::QueuedInput,
+                queued_message: queued_message.clone(),
+                history_record: self
+                    .input_queue
+                    .queued_user_message_history_records
+                    .get(index)
+                    .cloned()
+                    .unwrap_or(UserMessageHistoryRecord::UserMessageText),
+            });
+        }
+
+        let composer = self.bottom_pane.composer_draft_snapshot();
+        let draft = ThreadComposerState {
+            text: composer.text,
+            local_images: composer.local_images,
+            remote_image_urls: composer.remote_image_urls,
+            text_elements: composer.text_elements,
+            mention_bindings: composer.mention_bindings,
+            pending_pastes: composer.pending_pastes,
+        };
+        let draft = draft.has_content().then_some(draft);
+        let created_at_unix_ms = SystemTime::UNIX_EPOCH
+            .elapsed()
+            .map(|elapsed| elapsed.as_millis().try_into().unwrap_or(u64::MAX))
+            .unwrap_or_default();
+        QuotaHandoff {
+            format: HANDOFF_FORMAT.to_string(),
+            version: HANDOFF_VERSION,
+            handoff_id: Uuid::new_v4().to_string(),
+            created_at_unix_ms,
+            thread_id: thread_id.to_string(),
+            rollout_path: self.current_rollout_path.clone(),
+            resume_args,
+            messages,
+            draft,
+        }
+    }
+}
+
+fn handoff_path(
+    rollout_path: Option<&Path>,
+    codex_home: &Path,
+    thread_id: ThreadId,
+    handoff_id: &str,
+) -> Result<PathBuf> {
+    if let Some(rollout_path) = rollout_path {
+        match canonical_rollout_parent(rollout_path) {
+            Ok(parent) => {
+                let mut file_name = rollout_path
+                    .file_name()
+                    .unwrap_or_else(|| OsStr::new("rollout"))
+                    .to_os_string();
+                file_name.push(format!(".codex+k-{handoff_id}-handoff.json"));
+                return Ok(parent.join(file_name));
+            }
+            Err(error) => {
+                tracing::warn!(
+                    rollout_path = %rollout_path.display(),
+                    error = %error,
+                    "could not colocate +k input handoff with rollout; using persistent sessions directory"
+                );
+            }
+        }
+    }
+
+    let sessions_dir = codex_home.join("sessions");
+    fs::create_dir_all(&sessions_dir).wrap_err_with(|| {
+        format!(
+            "could not create fallback handoff directory {}",
+            sessions_dir.display()
+        )
+    })?;
+    let sessions_dir = fs::canonicalize(&sessions_dir).wrap_err_with(|| {
+        format!(
+            "could not resolve fallback handoff directory {}",
+            sessions_dir.display()
+        )
+    })?;
+    Ok(sessions_dir.join(format!("codex+k-{thread_id}-{handoff_id}-handoff.json")))
+}
+
+fn canonical_rollout_parent(rollout_path: &Path) -> Result<PathBuf> {
+    if rollout_path.exists() {
+        let rollout_path = fs::canonicalize(rollout_path).wrap_err_with(|| {
+            format!(
+                "could not resolve rollout path {} for input handoff",
+                rollout_path.display()
+            )
+        })?;
+        return rollout_path
+            .parent()
+            .map(Path::to_path_buf)
+            .ok_or_else(|| color_eyre::eyre::eyre!("resolved rollout path has no parent"));
+    }
+    let parent = rollout_path.parent().ok_or_else(|| {
+        color_eyre::eyre::eyre!(
+            "rollout path {} has no parent for input handoff",
+            rollout_path.display()
+        )
+    })?;
+    fs::canonicalize(parent).wrap_err_with(|| {
+        format!(
+            "could not resolve rollout directory {} for input handoff",
+            parent.display()
+        )
+    })
+}
+
+fn write_handoff(path: &Path, handoff: &QuotaHandoff) -> Result<()> {
+    let bytes = serde_json::to_vec_pretty(handoff).wrap_err("could not serialize input handoff")?;
+    if u64::try_from(bytes.len()).unwrap_or(u64::MAX) > MAX_HANDOFF_BYTES {
+        bail!(
+            "input handoff is larger than the {} MiB safety limit",
+            MAX_HANDOFF_BYTES / (1024 * 1024)
+        );
+    }
+
+    let parent = path
+        .parent()
+        .ok_or_else(|| color_eyre::eyre::eyre!("input handoff path has no parent"))?;
+    let temp_path = parent.join(format!(".codex+k-handoff-{}.tmp", Uuid::new_v4()));
+    let write_result = (|| -> Result<()> {
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        options.mode(0o600);
+        let mut file = options.open(&temp_path).wrap_err_with(|| {
+            format!(
+                "could not create temporary input handoff {}",
+                temp_path.display()
+            )
+        })?;
+        file.write_all(&bytes)
+            .wrap_err("could not write input handoff")?;
+        file.sync_all().wrap_err("could not sync input handoff")?;
+        fs::rename(&temp_path, path)
+            .wrap_err_with(|| format!("could not publish input handoff {}", path.display()))?;
+        #[cfg(unix)]
+        File::open(parent)
+            .and_then(|directory| directory.sync_all())
+            .wrap_err("could not sync input handoff directory")?;
+        Ok(())
+    })();
+    if write_result.is_err() {
+        let _ = fs::remove_file(&temp_path);
+    }
+    write_result
+}
+
+fn read_handoff(path: &Path) -> Result<QuotaHandoff> {
+    let metadata = fs::metadata(path)
+        .wrap_err_with(|| format!("could not inspect input handoff {}", path.display()))?;
+    if !metadata.is_file() {
+        bail!("input handoff {} is not a regular file", path.display());
+    }
+    if metadata.len() > MAX_HANDOFF_BYTES {
+        bail!(
+            "input handoff {} is larger than the {} MiB safety limit",
+            path.display(),
+            MAX_HANDOFF_BYTES / (1024 * 1024)
+        );
+    }
+    let bytes = fs::read(path)
+        .wrap_err_with(|| format!("could not read input handoff {}", path.display()))?;
+    serde_json::from_slice(&bytes)
+        .wrap_err_with(|| format!("could not parse input handoff {}", path.display()))
+}

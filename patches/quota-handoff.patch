+use std::fs;
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+
+use super::*;
+
+#[tokio::test]
+async fn quota_handoff_always_persists_resume_metadata() {
+    let (chat, _app_event_rx, _op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+    let directory = tempdir().unwrap();
+
+    let handoff_path = chat
+        .persist_quota_handoff(
+            thread_id,
+            vec!["--model".to_string(), "gpt-5.6".to_string()],
+            directory.path(),
+        )
+        .unwrap();
+    let serialized: serde_json::Value =
+        serde_json::from_slice(&fs::read(handoff_path).unwrap()).unwrap();
+    assert_eq!(serialized["resume_args"][0], "--model");
+    assert_eq!(serialized["messages"].as_array().unwrap().len(), 0);
+    assert!(serialized["draft"].is_null());
+}
+
+#[tokio::test]
+async fn quota_handoff_restores_each_pending_input_separately_and_keeps_the_draft() {
+    let (mut chat, _app_event_rx, _op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+    let directory = tempdir().unwrap();
+    let rollout_path = directory.path().join("rollout.jsonl");
+    fs::write(&rollout_path, "rollout").unwrap();
+    chat.current_rollout_path = Some(rollout_path);
+
+    chat.input_queue
+        .rejected_steers_queue
+        .push_back(UserMessage::from("rejected steer"));
+    chat.input_queue
+        .rejected_steer_history_records
+        .push_back(UserMessageHistoryRecord::UserMessageText);
+    chat.input_queue.pending_steers.push_back(PendingSteer {
+        user_message: UserMessage::from("pending steer"),
+        history_record: UserMessageHistoryRecord::UserMessageText,
+        compare_key: PendingSteerCompareKey {
+            message: "pending steer".to_string(),
+            image_count: 0,
+        },
+    });
+    chat.input_queue
+        .queued_user_messages
+        .push_back(QueuedUserMessage {
+            user_message: UserMessage::from("/status"),
+            action: QueuedInputAction::ParseSlash,
+            pending_pastes: vec![("[Pasted Content 1]".to_string(), "payload".to_string())],
+        });
+    chat.input_queue
+        .queued_user_message_history_records
+        .push_back(UserMessageHistoryRecord::UserMessageText);
+    chat.bottom_pane.set_composer_text(
+        "unfinished draft [Pasted Content 2]".to_string(),
+        Vec::new(),
+        Vec::new(),
+    );
+    chat.bottom_pane.set_composer_pending_pastes(vec![(
+        "[Pasted Content 2]".to_string(),
+        "draft payload".to_string(),
+    )]);
+
+    let handoff_path = chat
+        .persist_quota_handoff(
+            thread_id,
+            vec!["--model".to_string(), "gpt-5.6".to_string()],
+            directory.path(),
+        )
+        .unwrap();
+    #[cfg(unix)]
+    assert_eq!(
+        fs::metadata(&handoff_path).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+
+    let serialized: serde_json::Value =
+        serde_json::from_slice(&fs::read(&handoff_path).unwrap()).unwrap();
+    assert_eq!(serialized["format"], "codex+k-input-handoff");
+    assert_eq!(
+        serialized["messages"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|message| message["source"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        vec!["rejected_steer", "pending_steer", "queued_input"]
+    );
+
+    let (mut restored, _app_event_rx, _op_rx) = make_chatwidget_manual(None).await;
+    assert_eq!(
+        restored
+            .restore_quota_handoff_file(&handoff_path, thread_id)
+            .unwrap(),
+        3
+    );
+    assert_eq!(
+        restored
+            .input_queue
+            .queued_user_messages
+            .iter()
+            .map(|message| message.text.as_str())
+            .collect::<Vec<_>>(),
+        vec!["rejected steer", "pending steer", "/status"]
+    );
+    let queued_command = restored.input_queue.queued_user_messages.back().unwrap();
+    assert_eq!(queued_command.action, QueuedInputAction::ParseSlash);
+    assert_eq!(
+        queued_command.pending_pastes,
+        vec![("[Pasted Content 1]".to_string(), "payload".to_string())]
+    );
+    let draft = restored.bottom_pane.composer_draft_snapshot();
+    assert_eq!(draft.text, "unfinished draft [Pasted Content 2]");
+    assert_eq!(
+        draft.pending_pastes,
+        vec![(
+            "[Pasted Content 2]".to_string(),
+            "draft payload".to_string()
+        )]
+    );
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn quota_handoff_resolves_a_supervised_home_symlink_to_persistent_storage() {
+    use std::os::unix::fs::symlink;
+
+    let (mut chat, _app_event_rx, _op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+    let directory = tempdir().unwrap();
+    let persistent_sessions = directory.path().join("persistent-sessions");
+    let supervised_home = directory.path().join("agent-home");
+    fs::create_dir_all(&persistent_sessions).unwrap();
+    fs::create_dir_all(&supervised_home).unwrap();
+    symlink(&persistent_sessions, supervised_home.join("sessions")).unwrap();
+    let rollout_path = supervised_home.join("sessions/rollout.jsonl");
+    fs::write(&rollout_path, "rollout").unwrap();
+    chat.current_rollout_path = Some(rollout_path);
+    chat.bottom_pane
+        .set_composer_text("draft".to_string(), Vec::new(), Vec::new());
+
+    let handoff_path = chat
+        .persist_quota_handoff(thread_id, vec!["--model".to_string()], &supervised_home)
+        .unwrap();
+
+    assert_eq!(
+        handoff_path.parent().unwrap(),
+        fs::canonicalize(persistent_sessions).unwrap()
+    );
+}

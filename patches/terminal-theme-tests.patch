+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn waits_for_a_complete_pair_in_either_order() {
+        for order in [[10, 11], [11, 10]] {
+            let mut refresh = PaletteRefresh {
+                deadline: Some(Instant::now() + REPLY_TIMEOUT),
+                ..Default::default()
+            };
+            assert_eq!(refresh.observe(order[0], Some((220, 220, 220))), None);
+            assert_eq!(
+                refresh.observe(order[1], Some((0, 0, 0))),
+                Some(DefaultColors {
+                    fg: if order[0] == 10 {
+                        (220, 220, 220)
+                    } else {
+                        (0, 0, 0)
+                    },
+                    bg: if order[0] == 11 {
+                        (220, 220, 220)
+                    } else {
+                        (0, 0, 0)
+                    },
+                })
+            );
+            assert_eq!(refresh.observe(10, Some((255, 255, 255))), None);
+        }
+    }
+
+    #[test]
+    fn invalid_replies_cancel_the_pair_in_either_order() {
+        for order in [[10, 11], [11, 10]] {
+            let mut refresh = PaletteRefresh {
+                deadline: Some(Instant::now() + REPLY_TIMEOUT),
+                ..Default::default()
+            };
+            assert_eq!(refresh.observe(order[0], Some((0, 0, 0))), None);
+            assert_eq!(refresh.observe(order[1], None), None);
+            assert!(refresh.deadline.is_none());
+            assert_eq!(refresh.observe(order[1], Some((220, 220, 220))), None);
+            assert_eq!(refresh.observe(order[0], Some((0, 0, 0))), None);
+        }
+    }
+
+    #[test]
+    fn cancellation_discards_a_partial_pair() {
+        let mut refresh = PaletteRefresh {
+            deadline: Some(Instant::now() + REPLY_TIMEOUT),
+            ..Default::default()
+        };
+        assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+        refresh.cancel();
+        assert_eq!(refresh.observe(11, Some((220, 220, 220))), None);
+    }
+
+    #[test]
+    fn expired_pairs_ignore_late_replies() {
+        let mut refresh = PaletteRefresh {
+            deadline: Some(Instant::now() + REPLY_TIMEOUT),
+            ..Default::default()
+        };
+        assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+        refresh.deadline = Some(Instant::now());
+        assert_eq!(refresh.observe(11, Some((220, 220, 220))), None);
+        assert!(refresh.deadline.is_none());
+        assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+    }
+}

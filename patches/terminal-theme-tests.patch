+#[test]
+fn cancelling_preview_restores_automatic_theme_for_current_terminal() {
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let tx = AppEventSender::new(tx);
+    let dark = crate::terminal_probe::DefaultColors {
+        fg: (224, 224, 224),
+        bg: (24, 24, 24),
+    };
+    let light = crate::terminal_probe::DefaultColors {
+        fg: (0, 0, 0),
+        bg: (220, 220, 220),
+    };
+    let params = with_test_default_colors(dark, || {
+        highlight::restore_adaptive_theme();
+        build_theme_picker_params(None, None, Some(120))
+    });
+    params.on_selection_changed.as_ref().unwrap()(0, &tx);
+    assert!(!highlight::uses_adaptive_theme());
+    with_test_default_colors(light, || {
+        params.on_cancel.as_ref().unwrap()(&tx);
+        assert!(highlight::uses_adaptive_theme());
+        assert_eq!(
+            highlight::current_syntax_theme(),
+            highlight::resolve_theme_by_name("catppuccin-latte", None).unwrap()
+        );
+    });
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn invalid_or_expired_pairs_ignore_late_replies() {
+        for expired in [false, true] {
+            let mut refresh = PaletteRefresh {
+                deadline: Some(Instant::now() + REPLY_TIMEOUT),
+                ..Default::default()
+            };
+            assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+            if expired {
+                refresh.deadline = Some(Instant::now());
+            } else {
+                assert_eq!(refresh.observe(11, None), None);
+            }
+            assert_eq!(refresh.observe(11, Some((220, 220, 220))), None);
+            assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+        }
+    }
+}

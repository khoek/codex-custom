+#[test]
+fn scheme_change_refreshes_composer_and_preserves_interleaved_paste() -> Result<()> {
+    let repo_root = codex_utils_cargo_bin::repo_root()?;
+    let codex_home = tempfile::tempdir()?;
+    write_test_config(codex_home.path(), &repo_root)?;
+    let codex = codex_utils_cargo_bin::cargo_bin("codex-tui")
+        .or_else(|_| codex_utils_cargo_bin::cargo_bin("codex"))?;
+    // Only this test needs exact RGB output for its background-colour assertion.
+    let mut terminal = PtyCodex::start_binary(
+        Path::new("env"),
+        &repo_root,
+        codex_home,
+        &[
+            "COLORTERM=truecolor",
+            codex
+                .to_str()
+                .context("Codex executable path is not UTF-8")?,
+            "--no-alt-screen",
+        ],
+        None,
+    )?;
+    terminal.wait_for_startup()?;
+    terminal.wait_for_screen("GPT-5.6-Terra")?;
+
+    let output_start = terminal.output.len();
+    terminal.write_input(b"\x1b[?997;2nbefore-")?;
+    terminal.wait_for_focus_input("before-", Instant::now(), output_start)?;
+    terminal.write_input(
+        b"\x1b]10;rgb:0000/0000/0000\x1b\\\x1b[200~pasted\x1b[201~\x1b]11;rgb:dcdc/dcdc/dcdc\x1b\\",
+    )?;
+    terminal.wait_for_screen("before-pasted")?;
+    let deadline = Instant::now() + FOCUS_INPUT_TIMEOUT;
+    while Instant::now() < deadline {
+        terminal.read_output(Duration::from_millis(/*millis*/ 20))?;
+        if contains_bytes(&terminal.output[output_start..], b"48;2;211;211;211") {
+            return Ok(());
+        }
+        terminal.ensure_running()?;
+    }
+    bail!("composer did not repaint with the light terminal background")
+}

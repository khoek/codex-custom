+    #[cfg(feature = "bracketed-paste")]
+    #[test]
+    fn fragmented_theme_reports_preserve_keys_and_pasted_protocol_text() {
+        use crate::event::{ColorScheme, internal::OscColorPayload};
+        let input = b"a\x1b[?997;2n\x1b]10;rgb:0000/1111/2222\x1b\\\x1b[200~\x1b[?997;1n\x1b[201~b";
+        for split in 1..input.len() {
+            let mut parser = Parser::default();
+            parser.advance(&input[..split], true);
+            parser.advance(&input[split..], false);
+            assert_eq!(
+                parser.collect::<Vec<_>>(),
+                vec![
+                    InternalEvent::Event(Event::Key(KeyCode::Char('a').into())),
+                    InternalEvent::Event(Event::ColorSchemeChanged(ColorScheme::Light)),
+                    InternalEvent::OscColor {
+                        slot: 10,
+                        payload: OscColorPayload::Rgb { r: 0, g: 17, b: 34 }
+                    },
+                    InternalEvent::Event(Event::Paste("\x1b[?997;1n".into())),
+                    InternalEvent::Event(Event::Key(KeyCode::Char('b').into())),
+                ],
+                "split at {split}"
+            );
+        }
+    }
+
+    #[test]
+    fn unknown_scheme_reports_do_not_leak_into_keyboard_input() {
+        let mut parser = Parser::default();
+        parser.advance(b"\x1b[?997;3nx\x1b[?997;1n", false);
+        assert_eq!(
+            parser.collect::<Vec<_>>(),
+            vec![
+                InternalEvent::Event(Event::Key(KeyCode::Char('x').into())),
+                InternalEvent::Event(Event::ColorSchemeChanged(crate::event::ColorScheme::Dark)),
+            ]
+        );
+    }

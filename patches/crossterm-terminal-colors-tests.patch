+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use crate::event::internal::OscColorPayload;
+
+    #[test]
+    fn color_replies_are_opt_in_without_filtering_user_events() {
+        let color = InternalEvent::OscColor {
+            slot: 11,
+            payload: OscColorPayload::Rgb { r: 1, g: 2, b: 3 },
+        };
+        for colors in [false, true] {
+            let filter = StreamFilter { colors };
+            assert_eq!(filter.eval(&color), colors);
+            assert!(filter.eval(&InternalEvent::Event(Event::FocusGained)));
+            assert!(!filter.eval(&InternalEvent::CursorPosition(1, 2)));
+        }
+    }

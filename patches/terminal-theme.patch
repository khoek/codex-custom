@@ -0,0 +1,69 @@
+//! Refresh terminal defaults through the ordinary event stream, without another stdin reader.
+
+use crate::terminal_probe::DefaultColors;
+use std::io::Write;
+use std::time::Duration;
+use std::time::Instant;
+
+const REPLY_TIMEOUT: Duration = Duration::from_secs(1);
+
+pub(super) fn subscribe() {
+    write_sequence(b"\x1b[?2031h\x1b[?996n");
+}
+
+pub(super) fn unsubscribe() {
+    write_sequence(b"\x1b[?2031l");
+}
+
+fn write_sequence(sequence: &[u8]) -> bool {
+    let mut stdout = std::io::stdout().lock();
+    stdout
+        .write_all(sequence)
+        .and_then(|()| stdout.flush())
+        .is_ok()
+}
+
+#[derive(Default)]
+pub(super) struct PaletteRefresh {
+    deadline: Option<Instant>,
+    foreground: Option<(u8, u8, u8)>,
+    background: Option<(u8, u8, u8)>,
+}
+
+impl PaletteRefresh {
+    pub(super) fn request(&mut self) {
+        self.cancel();
+        self.deadline = write_sequence(b"\x1b]10;?\x1b\\\x1b]11;?\x1b\\")
+            .then(|| Instant::now() + REPLY_TIMEOUT);
+    }
+
+    pub(super) fn cancel(&mut self) {
+        *self = Self::default();
+    }
+
+    pub(super) fn observe(&mut self, slot: u8, rgb: Option<(u8, u8, u8)>) -> Option<DefaultColors> {
+        // A late reply must not complete a stale, partially answered query.
+        if Instant::now() >= self.deadline? {
+            self.cancel();
+            return None;
+        }
+        if !matches!(slot, 10 | 11) {
+            return None;
+        }
+        let Some(rgb) = rgb else {
+            self.cancel();
+            return None;
+        };
+        match slot {
+            10 => self.foreground = Some(rgb),
+            11 => self.background = Some(rgb),
+            _ => unreachable!(),
+        }
+        let colors = DefaultColors {
+            fg: self.foreground?,
+            bg: self.background?,
+        };
+        self.cancel();
+        Some(colors)
+    }
+}

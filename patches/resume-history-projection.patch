+#[tokio::test]
+async fn catch_up_skips_duplicate_resume_settings_boundary() {
+    let home = TempDir::new().expect("temp dir");
+    let store = projection_store(home.path()).await;
+    let thread_id = ThreadId::default();
+    create_paginated_thread(&store, thread_id).await;
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await
+        .expect("persist session metadata");
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id,
+            items: vec![RolloutItem::EventMsg(EventMsg::TokenCount(
+                TokenCountEvent {
+                    info: None,
+                    rate_limits: None,
+                },
+            ))],
+        })
+        .await
+        .expect("append token count");
+
+    let pool = codex_state::open_thread_history_db(&codex_state::SqliteConfig::new_for_testing(
+        home.path().abs(),
+    ))
+    .await
+    .expect("open thread history db");
+    let rollout_path = store
+        .live_rollout_path(thread_id)
+        .await
+        .expect("rollout path");
+    assert_eq!(projection_state(&pool, thread_id).await.1, 2);
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("close rollout writer");
+
+    let duplicate_settings = RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+        ThreadSettingsAppliedEvent {
+            thread_id: None,
+            thread_settings: ThreadSettingsSnapshot {
+                model: "gpt-5".to_string(),
+                model_provider_id: "openai".to_string(),
+                service_tier: None,
+                approval_policy: AskForApproval::Never,
+                approvals_reviewer: ApprovalsReviewer::User,
+                permission_profile: PermissionProfile::read_only(),
+                active_permission_profile: None,
+                cwd: home.path().abs(),
+                reasoning_effort: None,
+                reasoning_summary: None,
+                personality: None,
+                collaboration_mode: CollaborationMode {
+                    mode: ModeKind::Default,
+                    settings: Settings {
+                        model: "gpt-5".to_string(),
+                        reasoning_effort: None,
+                        developer_instructions: None,
+                    },
+                },
+            },
+        },
+    ));
+    append_suffix(
+        rollout_path.as_path(),
+        format!("{}\n", rollout_line(Some(1), duplicate_settings)).as_str(),
+    );
+
+    super::materialize_to_sqlite(&store, thread_id, rollout_path.as_path())
+        .await
+        .expect("recover duplicated resume boundary");
+    let duplicate_rollout_len =
+        i64::try_from(fs::metadata(&rollout_path).expect("rollout metadata").len())
+            .expect("rollout length");
+    assert_eq!(
+        projection_state(&pool, thread_id).await,
+        (duplicate_rollout_len, 2)
+    );
+
+    append_suffix(
+        rollout_path.as_path(),
+        format!("{}\n", rollout_line(Some(2), turn_started("turn-1"))).as_str(),
+    );
+    super::materialize_to_sqlite(&store, thread_id, rollout_path.as_path())
+        .await
+        .expect("project item after duplicated resume boundary");
+
+    let rollout_len = i64::try_from(fs::metadata(rollout_path).expect("rollout metadata").len())
+        .expect("rollout length");
+    let turn_ordinal = sqlx::query_scalar::<_, i64>(
+        "SELECT rollout_ordinal FROM thread_turns WHERE thread_id = ? AND turn_id = ?",
+    )
+    .bind(thread_id.to_string())
+    .bind("turn-1")
+    .fetch_one(&pool)
+    .await
+    .expect("read recovered turn");
+    assert_eq!(
+        (projection_state(&pool, thread_id).await, turn_ordinal),
+        ((rollout_len, 3), 2)
+    );
+}
